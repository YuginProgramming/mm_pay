{
    "compilerOptions": {
      "target": "ES2020",
      "module": "commonjs",
      "rootDir": ".",
      "outDir": "dist",
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true
    },
    "include": [
        "app.ts",
        "poster.ts",
        "debug/**/*.ts",
        "telegram/**/*.ts",
        "payment/**/*.ts",
        "database/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "tests",
        "vitest.config.ts"
    ]
  }